---
import DownloadButtons from '../components/DownloadButtons.astro';
import { Image, getImage } from 'astro:assets';
import shotHome from '../assets/shots/03-home.png';
import shotLogging from '../assets/shots/02-logging.png';
import shotTable from '../assets/shots/05-table.png';
import shotReport from '../assets/shots/01-report.png';
import shotSettings from '../assets/shots/04-settings.png';
import shotExcel from '../assets/shots/06-excel.png';

const REPO_URL = 'https://github.com/MihailM17/slate-log';
const RELEASES_URL = `${REPO_URL}/releases`;
const DONATE_URL = 'https://revolut.me/mihaildglt';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const withBase = (p) => `${base}/${String(p).replace(/^\//, '')}`;
const SITE = 'https://mihailm17.github.io/slate-log';

const shots = [
  { img: shotHome, caption: 'Project picker', alt: 'Project picker. Click to enlarge.' },
  { img: shotLogging, caption: 'Logging takes', alt: 'Logging takes. Click to enlarge.' },
  { img: shotTable, caption: 'Takes table', alt: 'Takes table. Click to enlarge.' },
  { img: shotReport, caption: 'Daily report', alt: 'Daily report. Click to enlarge.' },
  { img: shotSettings, caption: 'Settings', alt: 'Settings. Click to enlarge.' },
  { img: shotExcel, caption: 'Excel export', alt: 'Excel export. Click to enlarge.' },
];
// Full-size WebP for the lightbox, generated at build time. Thumbnails below
// use responsive AVIF/WebP srcsets so the page loads a fraction of the PNGs.
const fulls = await Promise.all(
  shots.map((s) => getImage({ src: s.img, width: 1600, format: 'webp', quality: 80 }))
);
const shotsWithFull = shots.map((s, i) => ({ ...s, full: fulls[i].src }));
const heroFull = await getImage({ src: shotLogging, width: 1600, format: 'webp', quality: 80 });
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="color-scheme" content="dark" />
  <title>Slate Log - Log every take</title>
  <meta name="description" content="Slate Log is a free, offline-first scene and take tracker for film shoots. Rate takes in one tap, import your script, log continuity stills from any phone, and export Excel, EDL and PDF daily reports." />
  <meta property="og:title" content="Slate Log - Log every take" />
  <meta property="og:description" content="Free, offline-first scene and take tracker. One-tap ratings, script import, set mode stills over WiFi, Excel, EDL and PDF exports." />
  <meta property="og:image" content={`${SITE}/og.jpg`} />
  <meta property="og:url" content={SITE} />
  <meta property="og:type" content="website" />
  <link rel="icon" type="image/png" href={withBase('icon-64.png')} />
  <link rel="apple-touch-icon" href={withBase('apple-touch-icon.png')} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@500;600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
</head>
<body>
  <div class="ambient" aria-hidden="true"></div>
  <div class="wrap">
    <nav>
      <a class="brand" href="#top">
        <img alt="Slate Log icon" src={withBase('icon-64.png')} width="30" height="30" />
        <span>SLATE <span class="log">LOG</span></span>
      </a>
      <div class="nav-links">
        <a href="#features">Features</a>
        <a href="#setmode">Set mode</a>
        <a href="#shots">Screenshots</a>
        <a href="#faq">FAQ</a>
      </div>
      <div class="nav-right">
        <span class="ver" data-dl-version-badge>v0.8.3</span>
        <a class="btn ghost" href={REPO_URL}>GitHub</a>
        <a class="btn donate-nav" href={DONATE_URL}>Donate</a>
      </div>
    </nav>

    <header class="hero" id="top">
      <div class="kicker">Offline-first · Free &amp; open source</div>
      <h1>Log every take.</h1>
      <p>A lightweight scene and take tracker for film shoots. Rate takes in one tap, keep everything on your machine, and export when you wrap.</p>

      <DownloadButtons />

      <div class="shot">
        <button class="shot-btn" data-full={heroFull.src} data-caption="Logging takes in Slate Log">
          <Image src={shotLogging} widths={[800, 1280, 1600]} sizes="100vw" formats={['avif', 'webp']} alt="Slate Log take logging view. Click to enlarge." loading="eager" />
          <span class="zoom-hint">Click to enlarge</span>
        </button>
      </div>
    </header>

    <section id="features">
      <div class="eyebrow">Built for the set</div>
      <h2 class="t">Everything between “action” and “cut”.</h2>
      <div class="grid">
        <div class="f"><h3>One-tap ratings</h3><p>Bad, Maybe, Good. Log a take between setups without breaking the rhythm of the day.</p></div>
        <div class="f"><h3>Full take detail</h3><p>Camera, lens presets or custom, INT/EXT, shoot day, timecode, stopwatch durations, camera plus audio filenames, quick notes.</p></div>
        <div class="f"><h3>Project picker</h3><p>A DaVinci-style projects home keeps each film's scenes and takes separate. Posters included.</p></div>
        <div class="f"><h3>Local SQLite</h3><p>Your data stays on your machine. No account, no cloud, works with zero signal.</p></div>
        <div class="f"><h3>Script import</h3><p>Pull scenes straight from a screenplay PDF or a CSV. No retyping the shot list.</p></div>
        <div class="f"><h3>Photos on takes</h3><p>Attach continuity stills to a scene and review them in a lightbox. They land in the report too.</p></div>
      </div>
    </section>

    <section class="setmode" id="setmode">
      <div class="setmode-grid">
        <div>
          <div class="eyebrow">Set mode: the phone link</div>
          <h2 class="t">Phones on set become continuity cameras.</h2>
          <p class="lede">Slate Log shows a QR code on your laptop. Anyone on the set WiFi scans it and pushes stills plus quick takes live. No install, no accounts, no internet needed.</p>
          <div class="steps">
            <div class="step"><b>1</b><span>Open Set mode on the laptop</span></div>
            <div class="step"><b>2</b><span>Phones scan the QR on the same WiFi</span></div>
            <div class="step"><b>3</b><span>Stills land on the scene instantly</span></div>
          </div>
        </div>
        <div class="setmode-visual" aria-label="Illustration of Set mode: a laptop showing a QR code next to a phone pushing a continuity still">
          <div class="laptop-card">
            <div class="laptop-head"><span class="laptop-dot"></span><span class="laptop-dot"></span><span class="laptop-dot"></span><span class="laptop-title">Slate Log: Set mode</span></div>
            <div class="qr-box" aria-hidden="true">
              <svg viewBox="0 0 100 100" role="img" aria-label="Illustrated QR code">
                <rect x="0" y="0" width="100" height="100" fill="#ece7df" rx="6"/>
                <g fill="#141311">
                  <rect x="10" y="10" width="24" height="24" rx="2"/><rect x="14" y="14" width="16" height="16" fill="#ece7df"/><rect x="18" y="18" width="8" height="8"/>
                  <rect x="66" y="10" width="24" height="24" rx="2"/><rect x="70" y="14" width="16" height="16" fill="#ece7df"/><rect x="74" y="18" width="8" height="8"/>
                  <rect x="10" y="66" width="24" height="24" rx="2"/><rect x="14" y="70" width="16" height="16" fill="#ece7df"/><rect x="18" y="74" width="8" height="8"/>
                  <rect x="42" y="10" width="8" height="8"/><rect x="52" y="18" width="6" height="6"/><rect x="42" y="28" width="6" height="12"/>
                  <rect x="10" y="42" width="12" height="6"/><rect x="26" y="46" width="8" height="8"/><rect x="42" y="42" width="16" height="6"/><rect x="62" y="42" width="6" height="14"/><rect x="74" y="46" width="12" height="6"/>
                  <rect x="10" y="56" width="6" height="6"/><rect x="48" y="54" width="10" height="10"/><rect x="62" y="60" width="14" height="6"/>
                  <rect x="42" y="70" width="6" height="14"/><rect x="52" y="66" width="12" height="6"/><rect x="52" y="78" width="8" height="8"/><rect x="68" y="70" width="6" height="6"/><rect x="78" y="76" width="12" height="14"/><rect x="66" y="84" width="8" height="6"/>
                </g>
              </svg>
            </div>
            <p class="mono">http://192.168.1.20:17831/s/abc123</p>
            <p class="scene-line">Phone is logging to: <b>Scene 12A Hallway chase</b></p>
          </div>
          <div class="phone-card">
            <div class="phone-notch"></div>
            <div class="phone-view">
              <span class="phone-slate">SC 12A · TK 4</span>
              <span class="phone-rec">● REC</span>
              <svg viewBox="0 0 120 70" aria-hidden="true"><rect x="0" y="0" width="120" height="70" fill="#211f1c"/><path d="M0 52 L30 24 L48 42 L66 20 L90 44 L104 32 L120 46 L120 70 L0 70 Z" fill="#2c2a26"/><circle cx="92" cy="16" r="7" fill="#c9a13b" opacity="0.8"/></svg>
            </div>
            <div class="phone-ratings"><span>Bad</span><span>Maybe</span><span class="good">Good</span></div>
            <div class="phone-snap">Snap still</div>
          </div>
          <p class="visual-cap">Illustrated. Your QR is generated live on your own WiFi.</p>
        </div>
      </div>
    </section>

    <section id="shots">
      <div class="eyebrow">See it</div>
      <h2 class="t">The real app, not a mockup.</h2>
      <p class="lede">Click any picture to open it full size.</p>
      <div class="shots">
        {shotsWithFull.map((s) => (
          <figure>
            <button class="shot-btn" data-full={s.full} data-caption={s.caption}>
              <Image src={s.img} width={720} formats={['avif', 'webp']} sizes="(max-width: 760px) 100vw, 340px" alt={s.alt} loading="lazy" />
              <span class="zoom-hint">Click to enlarge</span>
            </button>
            <figcaption>{s.caption}</figcaption>
          </figure>
        ))}
      </div>
    </section>

    <section class="tight">
      <div class="split">
        <div>
          <div class="eyebrow">Wrap progress</div>
          <h2 class="t small">Know where the day stands.</h2>
          <p>A wrap board shows scene by scene how much of the schedule is covered, so the last hour of the day is not a guessing game.</p>
        </div>
        <div class="prog">
          <div class="pr"><b>11</b><span>Kitchen argument</span><div class="bar"><i style="width:100%"></i></div></div>
          <div class="pr"><b>12A</b><span>Hallway chase</span><div class="bar"><i style="width:60%"></i></div></div>
          <div class="pr"><b>13</b><span>Rooftop sunrise</span><div class="bar"><i style="width:0%"></i></div></div>
        </div>
      </div>
    </section>

    <section class="tight" id="export">
      <div class="eyebrow">Wrap it up</div>
      <h2 class="t">From the set straight to the edit.</h2>
      <div class="grid">
        <div class="f"><h3>Excel export</h3><p>All Takes, Good Selects and per-day stats sheets, with photo counts.</p></div>
        <div class="f"><h3>EDL selects</h3><p>A good-selects timeline for Resolve, Premiere or Avid.</p></div>
        <div class="f"><h3>Daily report</h3><p>Print it or save it as a PDF for production, with contact sheet.</p></div>
      </div>
    </section>

    <section class="tight" id="download">
      <div class="dl">
        <h2>Roll camera.</h2>
        <p>Free and open source, built with Rust plus Tauri v2. Your OS is detected automatically. The file comes straight from GitHub Releases, you never leave this page.</p>
        <DownloadButtons />
        <div class="sysreq">
          <span>macOS 12 plus · Apple Silicon</span>
          <span>Windows 10 plus · x64</span>
          <span><a href={RELEASES_URL}>All releases and changelog</a></span>
        </div>
        <div class="note"><b>First launch on Mac:</b> the app is not Apple-signed yet. Right-click it, choose Open, then Open once. After that it launches with a double-click.<br /><b>Windows:</b> if SmartScreen appears, click More info, then Run anyway.</div>
      </div>
    </section>

    <section class="tight donate" id="donate">
      <div class="donate-card">
        <div>
          <div class="eyebrow">Keep it free</div>
          <h2 class="t small">Free forever. Fueled by coffee.</h2>
          <p>Slate Log costs nothing and never locks features behind a paywall. If it saves you a shooting day or a reshoot, a small donation keeps development going.</p>
        </div>
        <div class="donate-actions">
          <a class="btn primary big" href={DONATE_URL}>Donate</a>
          <a class="btn ghost big" href={REPO_URL}>Star on GitHub</a>
        </div>
      </div>
    </section>

    <section class="tight" id="faq">
      <div class="eyebrow">FAQ</div>
      <h2 class="t small">Questions from the set.</h2>
      <div class="faq">
        <details><summary>Is it really free?</summary><p>Yes. MIT-licensed, no account, no cloud, no subscription. Donations are optional and the app is fully functional without them.</p></details>
        <details><summary>Does it need internet on set?</summary><p>No. Everything is local SQLite. Set mode uses your local WiFi only, so no internet is needed.</p></details>
        <details><summary>Where is my data stored?</summary><p>On your machine next to the database, with a persistent trash folder so undo survives restarts. Open the Photos folder from Settings anytime.</p></details>
        <details><summary>What about Intel Macs?</summary><p>Current builds are Apple Silicon only (macOS 12 plus). Intel builds are not published. <a href={REPO_URL}>Open an issue</a> if you need one.</p></details>
        <details><summary>How do updates work?</summary><p>The in-app auto-updater checks GitHub Releases. You can also re-download here anytime. Same link, always latest.</p></details>
      </div>
    </section>

    <footer>
      <span>Slate Log · made by Mihail Mihaylov</span>
      <span class="foot-links"><a href={DONATE_URL}>Donate</a><a href={REPO_URL}>github.com/MihailM17/slate-log</a></span>
    </footer>
  </div>

  <div class="lightbox hidden" data-lightbox role="dialog" aria-modal="true" aria-label="Screenshot viewer">
    <button class="lb-close" data-lb-close aria-label="Close viewer">×</button>
    <button class="lb-prev" data-lb-prev aria-label="Previous picture">‹</button>
    <figure>
      <img data-lb-img alt="" />
      <figcaption data-lb-cap></figcaption>
    </figure>
    <button class="lb-next" data-lb-next aria-label="Next picture">›</button>
  </div>

  <script>
    // Keep the nav version badge in sync with the resolved release
    (async () => {
      try {
        const res = await fetch('https://api.github.com/repos/MihailM17/slate-log/releases/latest');
        if (!res.ok) return;
        const rel = await res.json();
        const badge = document.querySelector('[data-dl-version-badge]');
        if (badge && rel.tag_name) badge.textContent = rel.tag_name;
      } catch {}
    })();

    // Lightbox: every .shot-btn opens the full-size picture
    (() => {
      const btns = Array.from(document.querySelectorAll('.shot-btn'));
      const box = document.querySelector('[data-lightbox]');
      const img = box?.querySelector('[data-lb-img]');
      const cap = box?.querySelector('[data-lb-cap]');
      if (!box || !img || !cap || !btns.length) return;
      let idx = 0;
      const items = btns.map((b) => ({
        full: b.getAttribute('data-full') || '',
        caption: b.getAttribute('data-caption') || '',
      }));
      const show = (i) => {
        idx = (i + items.length) % items.length;
        img.setAttribute('src', items[idx].full);
        img.setAttribute('alt', items[idx].caption);
        cap.textContent = `${items[idx].caption} (${idx + 1}/${items.length})`;
      };
      const open = (i) => {
        show(i);
        box.classList.remove('hidden');
        document.body.style.overflow = 'hidden';
        box.querySelector('[data-lb-close]')?.focus();
      };
      const close = () => {
        box.classList.add('hidden');
        document.body.style.overflow = '';
      };
      btns.forEach((b, i) => b.addEventListener('click', () => open(i)));
      box.querySelector('[data-lb-close]')?.addEventListener('click', close);
      box.querySelector('[data-lb-prev]')?.addEventListener('click', (e) => { e.stopPropagation(); show(idx - 1); });
      box.querySelector('[data-lb-next]')?.addEventListener('click', (e) => { e.stopPropagation(); show(idx + 1); });
      box.addEventListener('click', (e) => { if (e.target === box) close(); });
      document.addEventListener('keydown', (e) => {
        if (box.classList.contains('hidden')) return;
        if (e.key === 'Escape') close();
        if (e.key === 'ArrowLeft') show(idx - 1);
        if (e.key === 'ArrowRight') show(idx + 1);
      });
    })();
  </script>
</body>
</html>

<style is:global>
  :root{
    --bg:#121110; --side:#141311; --panel:#1b1a17; --panel2:#211f1c;
    --line:#2c2a26; --txt:#ece7df; --mut:#a39c90; --dim:#6f6a61;
    --rust:#b44332; --rust2:#93382b; --amber:#c9a13b; --green:#7ba05b;
    --radius:10px;
  }
  *{ box-sizing:border-box; }
  html{ scroll-behavior:smooth; scroll-padding-top:20px; }
  body{ margin:0; background:var(--bg); color:var(--txt); font:15px/1.6 Inter,system-ui,sans-serif; position:relative; }
  /* Subtle animated gradient flare. Same palette, slow drift, disabled for reduced motion. */
  .ambient{
    position:fixed; inset:0; z-index:0; pointer-events:none; overflow:hidden;
    background:
      radial-gradient(560px 380px at 12% -4%, rgba(180,67,50,.20), transparent 65%),
      radial-gradient(640px 420px at 88% 6%, rgba(201,161,59,.10), transparent 65%),
      radial-gradient(900px 600px at 50% 110%, rgba(180,67,50,.08), transparent 60%);
    animation:ambient-drift 26s ease-in-out infinite alternate;
  }
  @keyframes ambient-drift{
    from{ transform:translate3d(-1.5%, -1%, 0) scale(1); opacity:.9; }
    to{ transform:translate3d(1.5%, 1.5%, 0) scale(1.04); opacity:1; }
  }
  @media (prefers-reduced-motion: reduce){
    html{ scroll-behavior:auto; }
    .ambient{ animation:none; }
  }
  a{ color:inherit; text-decoration:none; }
  .wrap{ max-width:1080px; margin:0 auto; padding:0 22px; position:relative; z-index:1; }
  h1,h2,h3{ font-family:'Barlow Condensed','Arial Narrow',sans-serif; letter-spacing:.02em; margin:0; line-height:1.05; }
  nav{ display:flex; justify-content:space-between; align-items:center; gap:16px; padding:22px 0; border-bottom:1px solid var(--line); }
  .brand{ display:flex; align-items:center; gap:10px; font:700 24px 'Barlow Condensed',sans-serif; letter-spacing:.06em; }
  .brand img{ width:30px; height:30px; border-radius:7px; }
  .brand .log{ color:var(--rust); }
  .nav-links{ display:flex; gap:18px; font-size:13.5px; font-weight:600; color:var(--mut); }
  .nav-links a:hover{ color:var(--txt); }
  .nav-right{ display:flex; align-items:center; gap:10px; }
  .ver{ font-size:12.5px; color:var(--mut); border:1px solid var(--line); border-radius:20px; padding:4px 12px; }
  .btn{ display:inline-block; border:1px solid var(--line); background:var(--panel2); color:var(--txt); border-radius:8px; padding:10px 18px; font-weight:600; font-size:14px; }
  .btn:hover{ border-color:var(--mut); }
  .btn.primary{ background:var(--rust); border-color:var(--rust); }
  .btn.primary:hover{ background:var(--rust2); }
  .btn.ghost{ background:transparent; }
  .btn.big{ padding:14px 28px; font:600 20px 'Barlow Condensed',sans-serif; letter-spacing:.04em; }
  .btn.donate-nav{ border-color:var(--rust); color:var(--txt); }
  .btn.donate-nav:hover{ background:var(--rust); border-color:var(--rust); }
  .hero{ padding:72px 0 28px; text-align:center; }
  .kicker{ font-size:11.5px; letter-spacing:.14em; text-transform:uppercase; color:var(--dim); }
  h1{ font-size:clamp(52px,9vw,96px); font-weight:700; margin:16px 0 18px; text-transform:uppercase; }
  .hero > p{ max-width:560px; margin:0 auto 28px; color:var(--mut); font-size:17px; }
  .fine{ margin-top:16px; color:var(--dim); font-size:12.5px; }
  .shot{ margin:48px auto 0; max-width:960px; border:1px solid var(--line); border-radius:14px; overflow:hidden; background:#000; box-shadow:0 30px 80px rgba(0,0,0,.55); }
  .shot-btn{ display:block; position:relative; width:100%; padding:0; border:0; background:#000; cursor:zoom-in; }
  .shot-btn img{ display:block; width:100%; height:auto; }
  .zoom-hint{
    position:absolute; right:12px; bottom:12px; font-size:12px; font-weight:600;
    background:rgba(20,19,17,.82); border:1px solid var(--line); border-radius:20px; padding:4px 12px; color:var(--mut);
    opacity:0; transition:opacity .2s;
  }
  .shot-btn:hover .zoom-hint, .shot-btn:focus-visible .zoom-hint{ opacity:1; }
  .shot-btn:focus-visible{ outline:2px solid var(--rust); outline-offset:2px; }
  section{ padding:72px 0 0; scroll-margin-top:16px; }
  section.tight{ padding-top:56px; }
  .eyebrow{ font-size:11.5px; letter-spacing:.14em; text-transform:uppercase; color:var(--rust); font-weight:600; margin-bottom:10px; }
  h2.t{ font-size:clamp(34px,5.5vw,52px); font-weight:600; text-transform:uppercase; margin-bottom:24px; max-width:700px; }
  h2.t.small{ font-size:clamp(32px,5vw,46px); }
  .lede{ color:var(--mut); max-width:640px; margin:0 0 22px; }
  .grid{ display:grid; grid-template-columns:repeat(auto-fit,minmax(240px,1fr)); gap:14px; }
  .f{ background:rgba(27,26,23,.92); border:1px solid var(--line); border-radius:12px; padding:22px; border-top:2px solid var(--rust); }
  .f h3{ font-size:24px; font-weight:600; margin-bottom:8px; }
  .f p{ margin:0; color:var(--mut); font-size:14.5px; }
  .setmode{ background:rgba(27,26,23,.94); border:1px solid var(--line); border-radius:14px; padding:36px 28px; margin-top:72px; scroll-margin-top:16px; }
  .setmode-grid{ display:grid; grid-template-columns:1.05fr .95fr; gap:32px; align-items:center; }
  .steps{ display:grid; gap:12px; margin-top:8px; }
  .step{ display:flex; gap:12px; align-items:center; background:var(--panel2); border:1px solid var(--line); border-radius:10px; padding:14px 16px; font-weight:600; font-size:14px; }
  .step b{ width:32px; height:32px; flex-shrink:0; display:grid; place-items:center; border-radius:50%; background:var(--rust); font-family:'Barlow Condensed'; font-size:18px; }
  .setmode-visual{ display:grid; grid-template-columns:1fr 150px; gap:12px; align-items:end; background:var(--side); border:1px solid var(--line); border-radius:12px; padding:16px; }
  .laptop-card{ background:var(--panel2); border:1px solid var(--line); border-radius:10px; padding:14px; }
  .laptop-head{ display:flex; align-items:center; gap:6px; margin-bottom:10px; }
  .laptop-dot{ width:9px; height:9px; border-radius:50%; background:#3a3835; }
  .laptop-title{ margin-left:6px; font-size:12px; font-weight:600; color:var(--mut); }
