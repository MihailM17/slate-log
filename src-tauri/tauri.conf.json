{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Slate Log",
  "mainBinaryName": "slate-log",
  "version": "0.5.0",
  "identifier": "com.slatelog.app",
  "build": {
    "frontendDist": "../src",
    "devUrl": "http://localhost:1421",
    "beforeDevCommand": "python3 -m http.server 1421 --directory src",
    "beforeBuildCommand": ""
  },
  "app": {
    "security": {
      "csp": {
        "default-src": "'self' customprotocol: asset:",
        "connect-src": "ipc: http://ipc.localhost",
        "font-src": "'self' asset: data:",
        "img-src": "'self' asset: data:",
        "style-src": "'self' asset:"
      }
    },
    "windows": [
      {
        "title": "Slate Log - Scene & take tracker",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 600,
        "center": true
      }
    ],
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  },
  "plugins": {
    "fs": {
      "requireLiteralLeadingDot": false
    },
    "updater": {
      "active": true,
      "dialog": false,
      "endpoints": [
        "https://github.com/MihailM17/slate-log/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJEMERCMDU4MUYwMzc0NDMKUldSRGRBTWZXTEFOdlRzY2J4NGYzaGVvV1V3blNMTG40L2ppTzFQTmV2NUpmV1pFQU40QjIrcEUK"
    }
  }
}
