{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Slate Log",
  "mainBinaryName": "slate-log",
  "version": "0.1.0",
  "identifier": "com.slatelog.app",
  "build": {
    "frontendDist": "../src",
    "devUrl": "http://localhost:1421",
    "beforeDevCommand": "python3 -m http.server 1421 --directory src",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "title": "Slate Log — Scene & take tracker",
        "width": 1300,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  },
  "plugins": {
    "fs": {
      "requireLiteralLeadingDot": false
    }
  }
}
